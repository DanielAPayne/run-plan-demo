      "id": "5572b4f0-9831-5ec2-9a32-a56765214a92",
      "name": "Any?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        440,
        0
      ]
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "\n// Follow-ups at 1, 3, 7 and 14 days after the lead arrived, until they book or opt out.\nconst BUSINESS = 'Example Roofing Co.';\nconst l = $json;\nconst first = (l.name || 'there').split(/\\s+/)[0];\nconst step = Number(l.step);\nconst texts = {\n  1: ['Still need a hand with your roof?', 'Just checking you saw our reply yesterday. Booking takes about a minute:'],\n  2: ['A quick question', 'Is the work still needed, or has it been sorted? Either answer helps us. If it is still needed, you can book here:'],\n  3: ['What an inspection includes', 'In case it is useful: an inspection takes about 45 minutes, and you keep the photos and the written summary whether or not you hire us. Book here:'],\n  4: ['Last note from us', 'This is our last message about your enquiry. If the timing is better later, this link will still work:'],\n};\nconst [subject, opening] = texts[step] || texts[4];\nconst body = [\n  `Hi ${first},`,\n  '',\n  `${opening} https://example-roofing.test/book`,\n  '',\n  `${BUSINESS}`,\n  'Reply STOP and we will not email you again.',\n].join('\\n');\nreturn { json: { id: l.id, email: l.email, step, subject, body } };\n"
      },
      "id": "9477b784-3258-5fdd-84aa-2481999e27ef",
      "name": "Draft follow-up",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        660,
        0
      ]
    },
    {
      "parameters": {
        "resource": "email",
        "operation": "send",
        "fromEmail": "hello@example-roofing.test",
        "toEmail": "={{ $json.email }}",
        "subject": "={{ $json.subject }}",
        "emailFormat": "text",
        "text": "={{ $json.body }}",
        "options": {
          "appendAttribution": false
        }
      },
      "id": "a9bd2068-0cce-5b42-b5b6-6f7629bf5de6",
      "name": "Send follow-up",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 2.1,
      "position": [
        880,
        0
      ],
      "credentials": {
        "smtp": {
          "id": "rdCredSmtp000001",
          "name": "Mailpit SMTP"
        }
      }
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "WITH j AS (\n  SELECT * FROM json_to_record($1::json) AS r(id bigint, step int, subject text)\n), m AS (\n  INSERT INTO messages (lead_id, kind, step, subject)\n  SELECT id, 'followup', step, subject FROM j\n  RETURNING lead_id, step\n)\nUPDATE leads l\nSET next_followup_step = CASE WHEN m.step >= 4 THEN NULL ELSE m.step + 1 END,\n    next_followup_at   = CASE WHEN m.step >= 4 THEN NULL\n                              ELSE l.received_at + (ARRAY[1, 3, 7, 14])[m.step + 1] * interval '1 day' END\nFROM m\nWHERE l.id = m.lead_id\nRETURNING l.id, l.next_followup_step;",
        "options": {
          "queryBatching": "independently",
          "queryReplacement": "={{ JSON.stringify({ id: $('Draft follow-up').item.json.id, step: $('Draft follow-up').item.json.step, subject: $('Draft follow-up').item.json.subject }) }}"
        }
      },
      "id": "0afdcd37-ed3e-550c-bc99-c23418fb85f4",
      "name": "Record follow-up",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [
        1100,
        0
      ],
