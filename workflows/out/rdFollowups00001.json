      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT id, name, email, service, next_followup_step AS step\nFROM leads\nWHERE replied_at IS NOT NULL AND booked_at IS NULL AND unsubscribed_at IS NULL AND NOT is_test\n  AND next_followup_step IS NOT NULL AND next_followup_at <= now()\nORDER BY next_followup_at\nLIMIT 20;",
        "options": {
          "queryBatching": "independently"
        }
      },
      "id": "f044f3e1-134b-50f7-be70-bac29bfe3101",
